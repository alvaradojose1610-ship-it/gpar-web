{
  "$meta": {
    "name": "Distribuidora GPar",
    "version": "1.0.0",
    "note": "Tokens del rediseño de catálogo. Esquinas rectas (radius 0) por decisión de identidad industrial.",
    "target": "Next.js App Router + React + Tailwind"
  },
  "color": {
    "brand": {
      "orange":       { "value": "#F57C00", "use": "Fondo de botón primario, franjas, acentos. Texto encima siempre #1D2430." },
      "orangeInk":    { "value": "#D96A00", "use": "Naranja para TEXTO sobre blanco: enlaces, kickers, 'Ver productos →'. Cumple AA." },
      "orangeSoft":   { "value": "#FFF3E6", "use": "Fondo de badge/píldora." },
      "orangeBorder": { "value": "#FBD3A8", "use": "Borde de badge/píldora." }
    },
    "ink": {
      "900": { "value": "#1D2430", "use": "Texto principal, fondo del footer, borde/fondo de botón secundario." },
      "600": { "value": "#5C6675", "use": "Párrafos y texto secundario." },
      "500": { "value": "#8A94A2", "use": "Metadatos, códigos, labels mono." },
      "400": { "value": "#98A2B0", "use": "Logos de marca, texto del footer." }
    },
    "line": {
      "default": { "value": "#E4E7EC" },
      "soft":    { "value": "#EEF0F3" }
    },
    "surface": {
      "base": { "value": "#FFFFFF" },
      "alt":  { "value": "#F7F8FA", "use": "Secciones alternas, inputs, thumbnails vacíos." }
    },
    "overlay": {
      "scrim":     { "value": "rgba(29,36,48,0.45)" },
      "heroWash":  { "value": "linear-gradient(100deg, rgba(255,255,255,0.97) 0%, rgba(255,255,255,0.93) 46%, rgba(255,255,255,0.62) 72%, rgba(255,255,255,0.30) 100%)", "use": "Velo sobre la foto del hero para garantizar legibilidad." }
    }
  },
  "font": {
    "display": { "value": "'Barlow Condensed', 'Arial Narrow', sans-serif", "weights": [600, 700, 800], "use": "Titulares, SIEMPRE en MAYÚSCULAS, tracking 0.02em, line-height 0.97–1.05." },
    "body":    { "value": "'IBM Plex Sans', system-ui, sans-serif", "weights": [400, 500, 600, 700] },
    "mono":    { "value": "'IBM Plex Mono', ui-monospace, monospace", "weights": [400, 500], "use": "Códigos de producto, contadores, labels en mayúsculas con tracking 0.10em." }
  },
  "fontSize": {
    "xs":     "11px",
    "sm":     "12.5px",
    "base":   "14px",
    "md":     "15.5px",
    "lg":     "17px",
    "h3":     "21px",
    "h2":     "clamp(28px, 3.4vw, 38px)",
    "h1List": "clamp(32px, 4.4vw, 46px)",
    "h1Hero": "clamp(34px, 5.4vw, 62px)"
  },
  "space": { "1": "4px", "2": "8px", "3": "12px", "4": "16px", "5": "20px", "6": "24px", "8": "32px", "10": "40px", "12": "48px", "15": "60px", "19": "76px" },
  "layout": {
    "container": "1220px",
    "headerHeight": { "base": "152px", "md": "136px", "lg": "80px", "nota": "Solo fallback de --gp-header-h. El valor real se mide en runtime con un ResizeObserver sobre .header; es el offset sticky de la barra de subfiltros." },
    "gutter":    { "mobile": "20px", "desktop": "24px" },
    "sectionY":  { "mobile": "40px", "desktop": "60px" },
    "grid": {
      "categorias": "repeat(auto-fill, minmax(228px, 1fr)) — 1 col <480, 2 col ≥480, 3 col ≥768, 4-5 col ≥1024",
      "productos":  "repeat(auto-fill, minmax(250px, 1fr))",
      "ayuda":      "repeat(auto-fit, minmax(215px, 1fr))"
    }
  },
  "radius": { "none": "0px", "round": "50%" },
  "shadow": {
    "bar":   "0 -6px 24px rgba(29,36,48,0.08)",
    "panel": "-12px 0 40px rgba(29,36,48,0.18)"
  },
  "motion": {
    "fast": "120ms",
    "base": "180ms",
    "ease": "cubic-bezier(0.2,0.6,0.2,1)",
    "strip": "42s linear infinite"
  },
  "breakpoints": { "sm": "480px", "md": "768px", "lg": "1024px", "xl": "1280px" },
  "zIndex": { "filters": 40, "bar": 55, "header": 60, "scrim": 80, "panel": 90 }
}
